# Required. Encrypts the SuperGrok session stored in Postgres.
# Generate: python -c "from agno.utils.encryption import generate_encryption_key; print(generate_encryption_key())"
XAI_TOKEN_ENCRYPTION_KEY=

# Optional. Metered fallback if SuperGrok OAuth inference is refused (HTTP 403).
# XAI_API_KEY=

# Optional. Only the Studio image/TTS tools. Models and embeddings do not use it.
# OPENAI_API_KEY=

# Optional. Faster web/docs tools for the platform agents (not the helpdesk).
# PARALLEL_API_KEY=

# Optional. Leave unset for local dev (RUNTIME_ENV=dev in compose.yaml).
# JWT_VERIFICATION_KEY=
# AGENTOS_URL=http://127.0.0.1:8000
# MCP_CONNECT_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# Database — compose defaults match these.
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
